{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "/usr/local/bin/bash -c \"cd '${CURSOR_PROJECT_DIR}' && AI_WORKDIR='${CURSOR_PROJECT_DIR}' ~/.cursor/hooks/on_submit.sh\"",
        "timeout": 16
      }
    ],
    "afterAgentResponse": [
      {
        "command": "/usr/local/bin/bash -c \"cd '${CURSOR_PROJECT_DIR}' && AI_WORKDIR='${CURSOR_PROJECT_DIR}' ~/.cursor/hooks/on_response.sh\"",
        "timeout": 16
      }
    ],
    "beforeShellExecution": [
      {
        "command": "/usr/local/bin/bash -c \"cd '${CURSOR_PROJECT_DIR}' && AI_WORKDIR='${CURSOR_PROJECT_DIR}' ~/.cursor/hooks/on_command_shell.sh\"",
        "timeout": 16
      }
    ],
    "preToolUse": [
      {
        "command": "/usr/local/bin/bash -c \"cd '${CURSOR_PROJECT_DIR}' && AI_WORKDIR='${CURSOR_PROJECT_DIR}' ~/.cursor/hooks/on_command_start.sh\"",
        "timeout": 16
      }
    ],
    "postToolUse": [
      {
        "command": "/usr/local/bin/bash -c \"cd ${CURSOR_PROJECT_DIR} && ~/.cursor/hooks/on_command_finish.sh\"",
        "timeout": 16
      }
    ],
    "sessionEnd": []
  }
}
